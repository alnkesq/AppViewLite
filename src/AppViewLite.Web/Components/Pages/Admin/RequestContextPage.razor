@page "/debug/requests/{guid}"
@using System.Runtime.InteropServices
@layout AppViewLite.Web.Components.Layout.NoLayout
@inject NavigationManager Navigation
@inject RequestContext RequestContext

@code {
    [Parameter] public required string Guid { get; set; }
    [Parameter][SupplyParameterFromQuery] public int? Zoom { get; set; }
    [Parameter][SupplyParameterFromQuery] public int? Seconds { get; set; }

    public int PixelsPerSecond => Zoom ?? 4096;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
    }

    private double StopwatchTicksToPixels(long stopwatchTicks)
    {
        var timespan = BlueskyRelationshipsClientBase.StopwatchTicksToTimespan(stopwatchTicks);
        return timespan.TotalSeconds * PixelsPerSecond;
    }
    
    protected override void OnInitialized()
    {
        RequestContext.EnsureAdministrator();
    }

}

@{
    var allReqs = RequestContext.RecentRequestContexts;
    RequestContext[] reqs;
    RequestContext? singleReq;
    var seconds = Seconds ?? 10;

    if (Guid == "*")
    {
        var minDate = DateTime.UtcNow.AddSeconds(-seconds);
        if (Zoom == null)
        {
            // Zoom is pixels per second
            Zoom = 2000 / seconds;
        }
        reqs = allReqs.Where(x => x.StartDate >= minDate).ToArray();
        singleReq = null;
    }
    else
    {
        var guid = System.Guid.Parse(Guid);
        singleReq = allReqs.FirstOrDefault(x => x.Guid == guid);
        if (singleReq == null)
        {
            Navigation.NavigateTo("/debug/requests");
            return;
        }
        reqs = [singleReq];
    }

    var reqsSnapshot = reqs.Select(req => req.GetSnapshotForPerformanceGraph(forMultiChart: singleReq == null)).Where(x => x.StopwatchTicks.Min != 0).ToArray();
    var bundles = new List<List<RequestContextSnapshotForPerformanceChart>>();
    foreach (var r in reqsSnapshot)
    {
        var b = bundles.FirstOrDefault(x => !x.Any(y => y.StopwatchTicks.OverlapsWith(r.StopwatchTicks)));
        if (b == null)
        {
            b = new List<RequestContextSnapshotForPerformanceChart>();
            bundles.Add(b);
        }
        b.Add(r);
    }
    foreach (var bundle in bundles)
    {
        bundle.Sort((a, b) => a.StopwatchTicks.Min.CompareTo(b.StopwatchTicks.Min));
    }

    var title = singleReq?.ToString() ?? "All requests";
    var now = System.Diagnostics.Stopwatch.GetTimestamp();
    var firstStopwatchTicks = singleReq != null ? reqsSnapshot[0].StopwatchTicks.Min : now - BlueskyRelationshipsClientBase.TimespanToStopwatchTicks(TimeSpan.FromSeconds(seconds));
    var finalStopwatchTicks = singleReq != null ? reqsSnapshot[0].StopwatchTicks.Max : now;
}

<PageTitle>@title</PageTitle>

<div style="position: fixed; margin-left: 10px;">
    <h3>@title</h3>
    <a class="blue-link" href="/debug">Debug</a> |
    <a class="blue-link" href="/debug/requests">Requests</a> |
    <a class="blue-link" href="/debug/performance">Performance by task kind</a> |
    @if (Guid != "*")
    {
        <a class="blue-link" href="/debug/requests/*">Show all requests</a><text> |</text>
    }
    <a class="blue-link" id="request-profiler-zoom-in" href="/debug/requests/@Guid?zoom=@(Math.Min(PixelsPerSecond * 2, 4 * 1024 * 1024) + (Seconds != null ? "&seconds=" + Seconds : null))">Zoom in</a> |
    <a class="blue-link" id="request-profiler-zoom-out" href="/debug/requests/@Guid?zoom=@(Math.Max(PixelsPerSecond / 2, 32) + (Seconds != null ? "&seconds=" + Seconds : null))">Zoom out</a>
</div>
@if (singleReq == null && (!BlueskyRelationshipsClientBase.ProfileAllRequests || RequestContext.RecentRequestsToProfile < 1000))
{
    <div><b>Warning! Chart might be incomplete, because APPVIEWLITE_PROFILE_ALL_REQUESTS is not enabled, or APPVIEWLITE_RECENT_REQUESTS_TO_PROFILE is too low.</b></div>
}
<script>
    document.documentElement.style.overflowX = 'scroll';
    document.addEventListener('keydown', e => {
        if(e.key == '+'){
            document.getElementById('request-profiler-zoom-in').click();
        }
        if(e.key == '-'){
            document.getElementById('request-profiler-zoom-out').click();
        }
    });
</script>
<br>
<br>
<br>
<br>
<br>
<br>

@foreach (var exponent in Enumerable.Range(1, 10))
{
    var micros = Math.Pow(10, exponent);
    var timespan = TimeSpan.FromMicroseconds(micros);
    var pixels = timespan.TotalSeconds * PixelsPerSecond;
    if (pixels >= 64)
    {
        <div style="position: fixed; height: 12px; margin-left: 10px; border-left: 1px solid black; border-right: 1px solid black; width: @(pixels)px; text-align: center; border-top: 1px solid black">@StringUtils.ToHumanTimeSpanForProfiler(timespan)</div>
        break;
    }
}


<br>
<br>

@foreach (var bundle in bundles)
{
    
    <div class="performance-timeline" style="width: @(Math.Min(StopwatchTicksToPixels(finalStopwatchTicks - firstStopwatchTicks), 1024 * 1024))px">

        @foreach (var r in bundle)
        {
            var delta = r.StopwatchTicks.Max - r.StopwatchTicks.Min;
            <div title="@r.Request.ToString()" class="performance-timeline-request" style="background-color: @(Program.HashToCssColor(MemoryMarshal.AsBytes([r.Request.Guid]), minLight: 90, maxLight: 90).ToString()); width: @(Math.Max(1, StopwatchTicksToPixels(delta)))px; left: @(StopwatchTicksToPixels(r.StopwatchTicks.Min - firstStopwatchTicks))px;"></div>
        }

        @foreach (var b in bundle.SelectMany(x => x.Entries))
        {
            var delta = b.End - b.Start;

            <div title="@b.TooltipText" class="performance-timeline-entry" style="background-color: @(delta.MaxGcGeneration != -1 ? "red" : b.TableName != null ? Program.HashToCssColor(b.TableName, b.Operation).ToString() : "transparent"); width: @(Math.Max(1, StopwatchTicksToPixels(delta.StopwatchTicks)))px; left: @(StopwatchTicksToPixels(b.Start.StopwatchTicks - firstStopwatchTicks))px;">
                @b.TableName
                @b.Operation
                @(delta.MaxGcGeneration != -1 ? $" [GC {delta.MaxGcGeneration}]" : null)
            </div>


        }

        @foreach (var b in bundle.SelectMany(x => x.LockLogs))
        {
            var delta = b.End - b.Start;

            <div title="@b.TooltipText" class="performance-timeline-lock performance-timeline-lock-@b.Operation" style="width: @(Math.Max(1, StopwatchTicksToPixels(delta.StopwatchTicks)))px; left: @(StopwatchTicksToPixels(b.Start.StopwatchTicks - firstStopwatchTicks))px;">
                @b.Operation
            </div>
        }

        @foreach (var b in bundle.SelectMany(x => x.NetworkLogs))
        {
            var delta = b.End - b.Start;

            <div title="@((b.Operation + (b.TableName != null ? $" ({b.TableName})" : null)) + "\n" + StringUtils.ToHumanTimeSpanForProfiler(BlueskyRelationshipsClientBase.StopwatchTicksToTimespan(delta.StopwatchTicks)))" class="performance-timeline-network" style="background-color: @Program.HashToCssColor(b.Operation, b.TableName); width: @(Math.Max(1, StopwatchTicksToPixels(delta.StopwatchTicks)))px; left: @(StopwatchTicksToPixels(b.Start.StopwatchTicks - firstStopwatchTicks))px;">
                @(b.Operation + (b.TableName != null ? $" ({b.TableName})" : null))
            </div>
        }

    </div>
}
<br>
<br>
<br>
<table class="performance-timeline-summary-table">
    <tr>
        <th title="Name of database table" style="width: 250px;">Table</th>
        <th title="Type of database operation">Operation</th>
        <th title="Number of database operations">Count</th>
        <th title="Number of direct IO reads">Reads</th>
        <th title="Bytes that were read via direct IO">Read bytes</th>
        <th title="Bytes that might have been read via memory-mapped memory">Mmap bytes</th>
        <th title="% wall clock time spent in GetIndex binary searches">Seek%</th>
        <th title="Total wall clock time">Duration</th>
    </tr>
    
@foreach (var item in reqsSnapshot.SelectMany(x => x.Entries).GroupBy(x => (x.TableName, x.Operation)).Where(x => x.Key != default).Select(x => (x.Key.TableName, x.Key.Operation, Count: x.Count(), StopwatchTicks: x.Sum(y => y.Delta.StopwatchTicks), IoReadBytes: x.Sum(x => x.Delta.IoReadBytes), IoReads: x.Sum(x => x.Delta.IoReads), PotentialMmapBytes: x.Sum(x => x.Delta.MmapPotentialReadBytes), SeekStopwatchTicks: x.Sum(x => x.Delta.SeekStopwatchTicks))).OrderByDescending(x => x.StopwatchTicks))
{
        <tr>
            <td>@item.TableName</td>
            <td>@item.Operation</td>
            <td>@item.Count</td>
            <td>@item.IoReads</td>
            <td>@(StringUtils.ToHumanBytes(item.IoReadBytes, allowByteGranularity: true))</td>
            <td>@(StringUtils.ToHumanBytes(item.PotentialMmapBytes, allowByteGranularity: true))</td>
            <td>@((100.0 * item.SeekStopwatchTicks / item.StopwatchTicks).ToString("0"))%</td>
            <td>
                    
                <div class="performance-timeline-summary-group" style="background: @Program.HashToCssColor(item.TableName!, item.Operation!); width: @StopwatchTicksToPixels(item.StopwatchTicks)px;">
                    @StringUtils.ToHumanTimeSpanForProfiler(BlueskyRelationshipsClientBase.StopwatchTicksToTimespan(item.StopwatchTicks))
                </div>
            </td>
    </tr>
}
</table>

